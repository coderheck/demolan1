from ultralytics import YOLO
import cv2
import easyocr
import csv
from datetime import datetime
import os

# MODEL
model = YOLO(
    r"C:\Users\Admin\OneDrive\Desktop\du an rung\runs\classify\train\weights\best.pt"
)

# OCR
reader = easyocr.Reader(['en'], gpu=False)

# OBS Camera
cap = cv2.VideoCapture(1)

if not cap.isOpened():
    print("Không mở được camera")
    exit()

CSV_FILE = "forest_log.csv"

if not os.path.exists(CSV_FILE):
    with open(CSV_FILE, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow([
            "time",
            "lat",
            "lon",
            "forest_class",
            "confidence"
        ])

frame_count = 0
telemetry = ""

while True:

    ret, frame = cap.read()

    if not ret:
        continue

  
    results = model(frame, verbose=False)

    probs = results[0].probs

    class_id = probs.top1
    conf = float(probs.top1conf)

    forest_class = model.names[class_id]

    

    frame_count += 1

    if frame_count % 20 == 0:

        crop = frame[430:470, 250:600]

        if crop.size != 0:

            gray = cv2.cvtColor(
                crop,
                cv2.COLOR_BGR2GRAY
            )

            _, thresh = cv2.threshold(
                gray,
                150,
                255,
                cv2.THRESH_BINARY
            )

            try:

                texts = reader.readtext(
                    thresh,
                    detail=0
                )

                telemetry = " ".join(texts)

            except:
                telemetry = ""

    

    lat = 10.7623
    lon = 106.6821

    

    if frame_count % 30 == 0:

        with open(
            CSV_FILE,
            "a",
            newline="",
            encoding="utf-8"
        ) as f:

            writer = csv.writer(f)

            writer.writerow([
                datetime.now(),
                lat,
                lon,
                forest_class,
                conf
            ])

    

    cv2.rectangle(
        frame,
        (10, 10),
        (900, 150),
        (0, 0, 0),
        -1
    )

    cv2.putText(
        frame,
        f"Forest: {forest_class} ({conf:.2f})",
        (20, 40),
        cv2.FONT_HERSHEY_SIMPLEX,
        1,
        (0, 255, 0),
        2
    )

    cv2.putText(
        frame,
        f"Telemetry: {telemetry}",
        (20, 90),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.7,
        (0, 255, 255),
        2
    )

    cv2.imshow(
        "Drone Forest AI",
        frame
    )

    if cv2.waitKey(1) == 27:
        break

cap.release()
cv2.destroyAllWindows()